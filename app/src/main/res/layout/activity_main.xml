<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:text="0"
        android:textColor="@android:color/white"
        android:textSize="52sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_clear"
                style="@style/AsmCalcKey"
                android:text="C" />

            <Button
                android:id="@+id/key_sign"
                style="@style/AsmCalcKey"
                android:text="+/−" />

            <Button
                android:id="@+id/key_divide"
                style="@style/AsmCalcKey"
                android:text="÷" />

            <Button
                android:id="@+id/key_multiply"
                style="@style/AsmCalcKey"
                android:text="×" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_7"
                style="@style/AsmCalcKey"
                android:text="7" />

            <Button
                android:id="@+id/key_8"
                style="@style/AsmCalcKey"
                android:text="8" />

            <Button
                android:id="@+id/key_9"
                style="@style/AsmCalcKey"
                android:text="9" />

            <Button
                android:id="@+id/key_minus"
                style="@style/AsmCalcKey"
                android:text="−" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_4"
                style="@style/AsmCalcKey"
                android:text="4" />

            <Button
                android:id="@+id/key_5"
                style="@style/AsmCalcKey"
                android:text="5" />

            <Button
                android:id="@+id/key_6"
                style="@style/AsmCalcKey"
                android:text="6" />

            <Button
                android:id="@+id/key_plus"
                style="@style/AsmCalcKey"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_1"
                style="@style/AsmCalcKey"
                android:text="1" />

            <Button
                android:id="@+id/key_2"
                style="@style/AsmCalcKey"
                android:text="2" />

            <Button
                android:id="@+id/key_3"
                style="@style/AsmCalcKey"
                android:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_0"
                style="@style/AsmCalcKey.Wide"
                android:text="0" />

            <Button
                android:id="@+id/key_dot"
                style="@style/AsmCalcKey"
                android:text="." />

            <Button
                android:id="@+id/key_equals"
                style="@style/AsmCalcKey.Equals"
                android:text="=" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
