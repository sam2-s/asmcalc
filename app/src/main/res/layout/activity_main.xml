<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp">

        <Button
            android:id="@+id/tab_calculator"
            style="@style/AsmCalcTab"
            android:text="@string/tab_calculator" />

        <Button
            android:id="@+id/tab_scientific"
            style="@style/AsmCalcTab"
            android:text="@string/tab_scientific" />

        <Button
            android:id="@+id/tab_programmer"
            style="@style/AsmCalcTab"
            android:text="@string/tab_programmer" />

        <Button
            android:id="@+id/tab_convert"
            style="@style/AsmCalcTab"
            android:text="@string/tab_convert" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF8A8A8A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/angle_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/key_function_background"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="#FF9FD4FF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#FF9E9E9E"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="@android:color/white"
            android:textSize="48sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/pad_calculator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/pad_scientific"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pad_programmer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pad_convert"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
